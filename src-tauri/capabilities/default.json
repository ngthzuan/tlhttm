{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window and educational platform",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "https://tuhoc.thzuan.io.vn",
      "https://tuhoc.thzuan.io.vn/*",
      "https://thzuan.io.vn",
      "https://thzuan.io.vn/*",
      "https://*.thzuan.io.vn",
      "https://*.thzuan.io.vn/*"
    ]
  },
  "permissions": [
    "core:default",
    "opener:default",
    "notification:default",
    "dialog:default",
    "fs:default",
    "clipboard-manager:default"
  ]
}